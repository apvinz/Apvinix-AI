# TRANSCORE AI backend configuration
# Copy this file to .env and adjust if needed. All values have sensible
# defaults if left unset.

# Where uploaded/processing/output files are stored (relative to backend/)
TRANSCORE_DATA_DIR=./data

# Max audio file size accepted, in MB
TRANSCORE_MAX_FILE_SIZE_MB=100

# Max audio duration accepted, in minutes
TRANSCORE_MAX_DURATION_MIN=20
